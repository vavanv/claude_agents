{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Edit|Write|NotebookEdit|Read|Grep|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hook.cjs"], "onFailure": "block" }
        ]
      }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hook.cjs"] }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hook.cjs"] }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hook.cjs"] }] }
    ]
  }
}
